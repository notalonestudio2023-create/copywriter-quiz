function renderQuiz(){
  const q=QS[state.cur];
  const pct=Math.round(state.cur/QS.length*100);
  const m=Math.floor(state.secondsLeft/60).toString().padStart(2,'0');
  const s=(state.secondsLeft%60).toString().padStart(2,'0');
  const warn=state.secondsLeft<180;
  const isLast=state.cur===QS.length-1;
  const cc=CAT_COLORS[q.cat]||['#eee','#333'];
  const optsHTML=q.opts.map((o,i)=>{
    let cls='opt'+(state.answers[state.cur]===i?' selected':'');
    return `<div class="${cls}" onclick="pick(${i})"><div class="opt-letter">${LETTERS[i]}</div><div class="opt-text">${o}</div></div>`;
  }).join('');
  document.getElementById('app').innerHTML=`
    <div class="timer-bar">
      <span class="timer-label">剩餘時間</span>
      <span class="timer-val${warn?' warn':''}" id="timerDisplay">${m}:${s}</span>
    </div>
    <div class="progress-wrap">
      <div class="progress-track"><div class="progress-fill" style="width:${pct}%"></div></div>
      <div class="progress-label">${state.cur+1} / ${QS.length}</div>
    </div>
    <div class="q-card">
      <div class="q-meta" style="background:${cc[0]}20">
        <span class="q-num">第 ${state.cur+1} 題</span>
        <span class="q-cat" style="background:${cc[0]};color:${cc[1]}">${q.cat}</span>
      </div>
      <div class="q-body"><div class="q-text">${q.q}</div></div>
      <div class="options">${optsHTML}</div>
    </div>
    <div class="nav">
      <button class="btn" onclick="prev()" ${state.cur===0?'disabled':''}>← 上一題</button>
      <span style="font-size:.77rem;color:var(--ink-3)">${state.answers.filter(a=>a!==null).length} / ${QS.length} 已作答</span>
      ${isLast
        ?`<button class="btn btn-primary" onclick="submitAndFinish()" ${state.answers[state.cur]===null?'disabled':''}>送出答卷 →</button>`
        :`<button class="btn btn-primary" onclick="next()" ${state.answers[state.cur]===null?'disabled':''}>下一題 →</button>`
      }
    </div>`;
}

function renderResult(){
  const score=totalScore();const raw=rawCorrect();const cats=catStats();
  const pillsHTML=state.answers.map((a,i)=>{
    const ok=a===QS[i].ans;
    return `<span class="summary-pill" style="background:${ok?'var(--correct-bg)':'var(--wrong-bg)'};color:${ok?'var(--correct)':'var(--wrong)'};border-color:${ok?'#a8d8c0':'#f0b8b8'}">Q${i+1} ${ok?'✓':'✗'}</span>`;
  }).join('');
  const catRows=Object.entries(cats).map(([n,d])=>`<tr><td>${n}</td><td>${d.correct} / ${d.total}</td></tr>`).join('');
  const lateNote=state.lateSeconds>0?`<div style="font-size:.77rem;color:#8B2020;margin-top:.3rem">逾時 ${Math.ceil(state.lateSeconds/60)} 分鐘，酌情扣 ${Math.min(10,Math.floor(state.lateSeconds/30))} 分</div>`:'';
  const levelText=score>=85?'優秀':score>=70?'良好':score>=55?'尚可':'需加強';
  document.getElementById('app').innerHTML=`
    <div class="result-wrap">
      <div class="submit-area">
        <h3>提交答卷</h3>
        <p>請確認姓名與聯絡電話無誤後送出。答卷僅能提交一次，送出後無法修改。</p>
        <div class="info-confirm">
          <div class="ic-item"><div class="ic-label">姓名</div><div class="ic-val" id="cname-display"></div></div>
          <div class="ic-item"><div class="ic-label">聯絡電話</div><div class="ic-val" id="cphone-display"></div></div>
        </div>
        <div class="summary-row">${pillsHTML}</div>
        <button class="btn-submit" onclick="submitResult()" id="btnSubmit" ${state.submitted?'disabled':''}>
          ${state.submitted?'✓ 答卷已送出':'送出答卷'}
        </button>
        <div class="status-msg" id="statusMsg"></div>
      </div>
      <div class="score-card" id="scoreCard">
        <div class="score-ring"><div class="score-big">${score}</div><div class="score-denom">/ 100</div></div>
        <div class="result-label">${levelText}</div>
        <div class="result-sub">答對 ${raw} / ${QS.length} 題（正確率 ${Math.round(raw/QS.length*100)}%）${state.lateSeconds>0?'，含逾時扣分':''}</div>
        ${lateNote}
        <div style="margin-top:1.25rem"><table class="cat-table"><thead><tr><th>類別</th><th>得分</th></tr></thead><tbody>${catRows}</tbody></table></div>
      </div>
      <div class="nextstep-box" id="nextstepBox">
        <strong>📩 接下來的步驟</strong><br>
        第一階段筆試結果，會根據您的答題情況決定是否進入第二階段面試。<br>
        請在送出答卷後，<strong>主動傳訊息給 HR 確認成績</strong>，並等候 HR 的面試結果通知。<br>
        感謝您參與定然數位公關的招募流程，期待與您進一步交流。
      </div>
    </div>`;
  document.getElementById('cname-display').textContent=state.name||'（未填寫）';
  document.getElementById('cphone-display').textContent=state.phone||'（未填寫）';
  if(state.submitted){document.getElementById('scoreCard').style.display='block';document.getElementById('nextstepBox').classList.add('show');}
}

function pick(i){state.answers[state.cur]=i;renderQuiz();}
function prev(){if(state.cur>0){state.cur--;render();}}
function next(){if(state.answers[state.cur]===null)return;state.cur++;render();}

async function submitAndFinish(){
  const un=state.answers.filter(a=>a===null).length;
  if(un>0){if(!confirm(`您還有 ${un} 題未作答，確定要送出答卷嗎？`))return;}
  clearInterval(state.timerInterval);
  state.phase='result';
  render();
  await submitResult();
}

function startTimer(){
  state.timerInterval=setInterval(()=>{
    if(state.secondsLeft>0){state.secondsLeft--;}else{state.lateSeconds++;}
    const el=document.getElementById('timerDisplay');
    if(!el)return;
    if(state.secondsLeft>0){
      const m=Math.floor(state.secondsLeft/60).toString().padStart(2,'0');
      const s=(state.secondsLeft%60).toString().padStart(2,'0');
      el.textContent=m+':'+s;el.className='timer-val'+(state.secondsLeft<180?' warn':'');
    }else{
      const ms=Math.floor(state.lateSeconds/60).toString().padStart(2,'0');
      const ss=(state.lateSeconds%60).toString().padStart(2,'0');
      el.textContent='+'+ms+':'+ss;el.className='timer-val warn';
    }
  },1000);
}

function validateInfo(){
  const n=document.getElementById('cName');const p=document.getElementById('cPhone');
  const ne=document.getElementById('nameErr');const pe=document.getElementById('phoneErr');
  let ok=true;
  if(!n.value.trim()){n.classList.add('error');ne.classList.add('show');ok=false;}else{n.classList.remove('error');ne.classList.remove('show');}
  if(!p.value.trim()){p.classList.add('error');pe.classList.add('show');ok=false;}else{p.classList.remove('error');pe.classList.remove('show');}
  return ok;
}

function startQuiz(){
  if(!validateInfo())return;
  state.name=document.getElementById('cName').value.trim();
  state.phone=document.getElementById('cPhone').value.trim();
  state.phase='quiz';state.cur=0;render();startTimer();
}

async function submitResult(){
  const score=totalScore();const raw=rawCorrect();const cats=catStats();
  const now=new Date().toLocaleString('zh-TW',{timeZone:'Asia/Taipei'});
  const details=state.answers.map((a,i)=>{const ok=a===QS[i].ans;const sel=a!==null?LETTERS[a]:'未作答';return`Q${i+1}:${sel}(${ok?'✓':'✗'})`;
  });
  const catSummary=Object.entries(cats).map(([n,d])=>`${n}:${d.correct}/${d.total}`).join(' | ');
  const payload={name:state.name,phone:state.phone,score,rawCorrect:raw,total:QS.length,pct:Math.round(raw/QS.length*100),lateSeconds:state.lateSeconds,catSummary,details:details.join(', '),submittedAt:now};
  const btn=document.getElementById('btnSubmit');const msg=document.getElementById('statusMsg');
  btn.disabled=true;msg.className='status-msg sending';msg.textContent='送出中，請稍候…';
  try{
    await fetch(GOOGLE_SCRIPT_URL,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
    state.submitted=true;
    msg.className='status-msg success';msg.textContent='✓ 答卷已成功送出，請主動傳訊息給 HR 確認成績。';
    btn.textContent='✓ 答卷已送出';
    document.getElementById('scoreCard').style.display='block';
    document.getElementById('nextstepBox').classList.add('show');
  }catch(e){msg.className='status-msg fail';msg.textContent='送出失敗，請確認網路連線後再試一次。';btn.disabled=false;}
}

render();
</script>
</body>
</html>
